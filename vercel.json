{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/aggregate-views",
      "schedule": "5 2 * * *"
    },
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/ai/worker",
      "schedule": "*/5 * * * *"
    }
  ]
}
