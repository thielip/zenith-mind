{
  "name": "zenith-mind",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify:cf-build": "node scripts/verify-cf-build-env.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:next:public": "node scripts/cf-next-build.mjs",
    "build:cf": "node scripts/cf-public-build.mjs",
    "deploy:cf": "node scripts/cf-deploy.mjs",
    "build:cf:full": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:a11y": "playwright test tests/a11y --config=playwright.config.ts",
    "security:audit": "audit-ci --moderate",
    "sync:categories": "node scripts/sync-default-categories.mjs",
    "db:migrate": "node scripts/prisma-with-local-env.mjs migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:local": "node scripts/prisma-with-local-env.mjs migrate deploy",
    "db:connection-info": "node --env-file=.env.local scripts/db-connection-info.mjs",
    "db:migrate:status": "node scripts/prisma-with-local-env.mjs migrate status",
    "verify:sentry": "node scripts/verify-sentry-env.mjs",
    "admin:ensure": "node scripts/ensure-admin.mjs",
    "guest:ensure": "node scripts/ensure-guest.mjs",
    "redirects:warm": "node scripts/warm-redirect-cache.mjs",
    "db:generate:local": "node scripts/prisma-with-local-env.mjs generate",
    "postinstall": "prisma generate"
  },
