# .env.example — 安全可提交（不含真實值）
# 複製此檔為 .env.local 並填入真實值
# 所有變數皆由 env.ts (t3-env) 型別驗證

# ── 資料庫（Supabase PostgreSQL）──────────────────────────
# App 常用 Transaction pooler（:6543 + pgbouncer）；Prisma migrate 需 directUrl。
# 後台「Database」→「Connection string」：Transaction 貼到 DATABASE_URL；Session 或 Direct 貼到 DIRECT_URL。
DATABASE_URL=
DIRECT_URL=

# ── JWT Secrets（openssl rand -hex 64 各生成一組）────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Upstash Redis ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── TOTP 2FA 加密金鑰（openssl rand -hex 32，產出 64 字元）
TOTP_ENCRYPTION_KEY=

# ── Gemini（Admin 後台 AI，OpenAI 相容介面，絕不可 NEXT_PUBLIC_）
# 使用 Gemini 3.1 Flash-Lite（透過 OpenAI 相容介面）
# 目前強制使用 gemini-3.1-flash-lite-preview 以確保穩定性與免費額度
# 若官方後續提供更穩定的非-preview 版本，再行更新模型名稱
GEMINI_API_KEY=

# ── GA4 Reporting API（Service Account 拆分儲存）─────────
# GA4_PRIVATE_KEY：JSON 金鑰內的 private_key，保留 \n 轉義並以雙引號包住整段 PEM
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
GA4_PROPERTY_ID=

# ── Google Ads / Search Console / Merchant Center / BigQuery（可選）──
# 若要在後台儀表板顯示這些平台的實際 API 數據，需先補齊對應授權。
# Google Ads API 需 OAuth + Developer Token；MCC 經理帳戶請另設 LOGIN_CUSTOMER_ID。
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://www.getzenithmind.com/
GOOGLE_MERCHANT_CENTER_ACCOUNT_ID=
GOOGLE_CLOUD_PROJECT_ID=
BIGQUERY_DATASET_ID=

# ── Webhook ────────────────────────────────────────────────
WEBHOOK_SECRET=
REVALIDATE_SECRET=

# ── Supabase Storage ──────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Alert 通知（Gmail SMTP，可選）────────────────────────
ALERT_EMAIL_USER=
ALERT_EMAIL_PASS=
ALERT_EMAIL_TO=

# ── 公開環境變數（NEXT_PUBLIC_）──────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.getzenithmind.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Tag Manager（與 GA4 並存；行銷於 GTM 容器內自行加碼）
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
