# .env.example — 安全可提交（不含真實值）
# 複製此檔為 .env.local 並填入真實值
# 所有變數皆由 env.ts (t3-env) 型別驗證

# ── 資料庫（Supabase PostgreSQL）──────────────────────────
# ⚠ 本機 .env.local 請用「Dev」專案連線，勿與 Vercel Production 共用同一 URL（會直接改到線上資料）。
# App：Transaction pooler → DATABASE_URL（常見 :6543）；Prisma migrate → DIRECT_URL（常見 :5432）。
# 同一 pooler host 不同 port 仍是同一個 DB。分離說明：docs/DATABASE-ENVIRONMENTS.md
# 僅在確定要對 production 跑 migrate 時才設 ALLOW_PRODUCTION_DATABASE=1
DATABASE_URL=
DIRECT_URL=
# ALLOW_PRODUCTION_DATABASE=1

# ── JWT Secrets（openssl rand -hex 64 各生成一組）────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Upstash Redis ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── TOTP 2FA 加密金鑰（openssl rand -hex 32，產出 64 字元）
TOTP_ENCRYPTION_KEY=

# ── Gemini（Admin 後台 AI，OpenAI 相容介面，絕不可 NEXT_PUBLIC_）
# 使用 Gemini 3.1 Flash-Lite（透過 OpenAI 相容介面）
# 目前強制使用 gemini-3.1-flash-lite-preview 以確保穩定性與免費額度
# 若官方後續提供更穩定的非-preview 版本，再行更新模型名稱
GEMINI_API_KEY=

# ── GA4 Reporting API（Service Account 拆分儲存）─────────
# GA4_PRIVATE_KEY：JSON 金鑰內的 private_key，保留 \n 轉義並以雙引號包住整段 PEM
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
GA4_PROPERTY_ID=
# GA4 服務帳號無法在 UI 新增時，用 OAuth 授權（可與 GSC 共用 Client）
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=

# ── Google Ads / Search Console / Merchant Center / BigQuery（可選）──
# 若要在後台儀表板顯示這些平台的實際 API 數據，需先補齊對應授權。
# Google Ads API 需 OAuth + Developer Token；MCC 經理帳戶請另設 LOGIN_CUSTOMER_ID。
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://www.getzenithmind.com/
# GSC 服務帳號加不進「使用者」時用 OAuth（優先於 GA4 服務帳號）
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=
GOOGLE_MERCHANT_CENTER_ACCOUNT_ID=
GOOGLE_CLOUD_PROJECT_ID=
BIGQUERY_DATASET_ID=

# ── Webhook ────────────────────────────────────────────────
WEBHOOK_SECRET=
REVALIDATE_SECRET=
# On-demand ISR / 全站快取清除（openssl rand -hex 32，≥32 字元）
CRON_SECRET=
# Vercel Cron / AI Worker（openssl rand -hex 32，≥32 字元）
PAGEVIEW_HASH_SALT=
# 公開站 page-view 訪客 hash（openssl rand -hex 32，≥32 字元）
REDIRECT_LOOKUP_SECRET=
# 轉址查詢 API 簽章（openssl rand -hex 32，≥32 字元）

# ── Supabase Storage ──────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Alert 通知（Gmail SMTP，可選）────────────────────────
ALERT_EMAIL_USER=
ALERT_EMAIL_PASS=
ALERT_EMAIL_TO=

# ── GEO 第三方能見度（可選；Admin GEO 儀表板）────────────
# 自訂 REST：GET {GEO_API_BASE_URL}/geo?domain=...，Header: Authorization: Bearer {GEO_API_KEY}
GEO_API_BASE_URL=
GEO_API_KEY=
# Semrush Analytics API（domain_ranks 代理指標，非 AI 即時 SoV）
SEMRUSH_API_KEY=
SEMRUSH_DOMAIN=
SEMRUSH_DATABASE=us
# Otterly 尚無公開 API；僅提示。可自建 proxy 後設 GEO_API_BASE_URL
OTTERLY_API_KEY=

# ── Sentry（可選；本機請寫入 .env.local，執行 npm run verify:sentry 檢查）──
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=xxx-py
SENTRY_PROJECT=zenithmind
# 僅 CI 上傳 source map 需要（勿提交）
SENTRY_AUTH_TOKEN=

# ── 公開環境變數（NEXT_PUBLIC_）──────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.getzenithmind.com
# Cloudflare 公開站：後台導向 Vercel（僅 CF Worker 需要；Vercel 全站部署可省略）
ADMIN_DEPLOYMENT_URL=https://your-project.vercel.app
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Tag Manager（與 GA4 並存；行銷於 GTM 容器內自行加碼）
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
