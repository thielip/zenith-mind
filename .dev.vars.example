# 複製為 .dev.vars（勿提交 Git）：cp .dev.vars.example .dev.vars
# 本機 `npm run preview:cf` / `wrangler dev` 會讀取此檔

# ── 建置／開發輔助 ─────────────────────────────────────────
SKIP_ENV_VALIDATION=true
NEXTJS_ENV=development

# ── 公開（可與 wrangler.toml [vars] 相同）──────────────────
